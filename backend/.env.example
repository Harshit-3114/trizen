# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./trizen.db
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# S3 / Supabase S3-compatible (only when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
